# Copy to .env and fill in. Never commit .env.
# Every value except OPENAI_API_KEY has a working default for local Docker.

OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Postgres (also read by docker-compose.yml)
# PG_HOST=localhost
# PG_PORT=5433
# PG_USER=salesonboard
# PG_PASSWORD=salesonboard
# CONTROL_DB=control

# LLM cost, euros per 1M tokens, and the per-batch limit
# PRICE_INPUT_PER_MTOK_EUR=0.14
# PRICE_OUTPUT_PER_MTOK_EUR=0.55
# BATCH_COST_LIMIT_EUR=1.0
