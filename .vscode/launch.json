{
  "version": "0.2.0",
  "configurations": [
    {
      // Debug whichever Python file is open in the editor.
      // PYTHONPATH lets the file import salesonboard; cwd keeps relative
      // paths like demo_data/ pointing at the project root.
      "name": "Python: Current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
